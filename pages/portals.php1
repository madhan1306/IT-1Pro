<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof feather !== 'undefined') {
        feather.replace();
    }

    // ==========================================
    // VERTICAL STACKED ANALOG CLOCKS LOGIC
    // ==========================================
    const clocksConfig = <?php echo $json_clocks; ?>;
    const container = document.getElementById('clockContainer');

    function renderClocks() {
        const now = new Date();
        container.innerHTML = ''; 

        clocksConfig.forEach(clock => {
            let formattedTime = "00:00 AM";
            let formattedDate = "---";
            let hDeg = 0, mDeg = 0, sDeg = 0;

            try {
                const tzTimeStr = now.toLocaleString('en-US', { timeZone: clock.timezone });
                const tzDate = new Date(tzTimeStr);
                
                formattedTime = new Intl.DateTimeFormat('en-US', {
                    hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true
                }).format(tzDate);
                
                formattedDate = new Intl.DateTimeFormat('en-US', {
                    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                }).format(tzDate);

                const h = tzDate.getHours();
                const m = tzDate.getMinutes();
                const s = tzDate.getSeconds();

                hDeg = (h % 12) * 30 + (m * 0.5);
                mDeg = m * 6 + (s * 0.1);
                sDeg = s * 6;

            } catch (e) {
                formattedTime = "Invalid TZ";
            }

            // Generate clock face (Numbers and Marks)
            let faceHTML = '';
            for (let i = 0; i < 60; i++) {
                if (i % 5 !== 0) {
                    faceHTML += `<div class="clock-minute-mark" style="transform: rotate(${i * 6}deg);"></div>`;
                } else {
                    faceHTML += `<div class="clock-hour-mark" style="transform: rotate(${i * 6}deg);"></div>`;
                }
            }
            
            // Place 1-12 Numbers in a circle inside the tick marks
            for (let i = 1; i <= 12; i++) {
                let angle = i * 30;
                let rad = angle * (Math.PI / 180);
                let x = Math.sin(rad) * 36; 
                let y = -Math.cos(rad) * 36;
                faceHTML += `<div class="clock-number" style="transform: translate(calc(-50% + ${x}px), calc(-50% + ${y}px));">${i}</div>`;
            }

            // Create the item HTML dynamically
            const item = document.createElement('div');
            item.className = 'clock-item';
            item.innerHTML = `
                <div class="clock-label">${escapeHtml(clock.label)}</div>
                
                <div class="analog-clock">
                    ${faceHTML}
                    <div class="clock-hand hand-hour" style="transform: rotate(${hDeg}deg);"></div>
                    <div class="clock-hand hand-minute" style="transform: rotate(${mDeg}deg);"></div>
                    <div class="clock-hand hand-second" style="transform: rotate(${sDeg}deg);"></div>
                </div>

                <div class="clock-time">${formattedTime}</div>
                <div class="clock-date">${formattedDate}</div>
            `;
            container.appendChild(item);
        });
    }

    function escapeHtml(unsafe) {
        return unsafe
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    if (clocksConfig && clocksConfig.length > 0) {
        renderClocks();
        setInterval(renderClocks, 1000);
    }


    // ==========================================
    // PORTAL SEARCH & FILTER LOGIC
    // ==========================================
    const searchInput = document.getElementById('portalSearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const tabs = document.querySelectorAll('.nav-tabs .nav-link');
    const tabPanes = document.querySelectorAll('.tab-pane');
    const jsEmptyState = document.getElementById('js-empty-state');
    const jsEmptyText = document.querySelector('.js-empty-text');
    let activeTab = '<?php echo htmlspecialchars($active_category_id); ?>';
    let timeout = null;

    if (searchInput) {
        function filterPortals() {
            const term = searchInput.value.trim().toLowerCase();
            clearBtn.style.display = term.length > 0 ? 'block' : 'none';

            const activePaneId = activeTab === 'all' ? 'all-tab-pane' : 'cat-' + activeTab + '-tab-pane';
            const activePane = document.getElementById(activePaneId);
            if (!activePane) return;

            const portals = activePane.querySelectorAll('.portal-btn');
            let visibleCount = 0;

            portals.forEach(card => {
                const name = card.querySelector('.portal-btn-name')?.textContent.toLowerCase() || '';
                if (name.includes(term) || term === '') {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (visibleCount === 0 && portals.length > 0) {
                jsEmptyText.textContent = `No portals found matching "${term}" in this category.`;
                jsEmptyState.style.display = 'block';
                activePane.querySelector('.portal-grid').style.display = 'none';
            } else {
                jsEmptyState.style.display = 'none';
                if (activePane.querySelector('.portal-grid')) {
                    activePane.querySelector('.portal-grid').style.display = 'grid';
                }
            }
        }

        tabs.forEach(tab => {
            tab.addEventListener('click', e => {
                e.preventDefault();
                e.stopPropagation();

                tabs.forEach(t => t.classList.remove('active'));
                tabPanes.forEach(p => p.classList.remove('show', 'active'));

                tab.classList.add('active');

                const tabIdMatch = tab.id.match(/cat-(\d+)-tab/);
                const tabId = tab.id === 'all-tab' ? 'all' : (tabIdMatch ? tabIdMatch[1] : null);
                
                if (tabId) {
                    activeTab = tabId;

                    const targetPane = document.querySelector(`#${tabId === 'all' ? 'all-tab-pane' : 'cat-' + tabId + '-tab-pane'}`);
                    if (targetPane) {
                        targetPane.classList.add('show', 'active');
                    }
                    
                    filterPortals();
                }
            });
        });

        searchInput.addEventListener('input', function() {
            clearTimeout(timeout);
            timeout = setTimeout(filterPortals, 150);
        });
        
        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            clearBtn.style.display = 'none';
            filterPortals();
        });

        filterPortals();
    }
});
</script>