<?php
// FILE: /pages/portals.php - FINAL CORRECTED VERSION WITH FULL-WIDTH FLUID GRID & ALERTS

include_once '../includes/error_handler.php';
// --- Declare this as a public page so auth.php does not kick out users with expired sessions ---
if (!defined('ALLOW_PUBLIC_ACCESS')) {
    define('ALLOW_PUBLIC_ACCESS', true);
}

include_once '../includes/db_connect.php';
include_once '../includes/auth.php';

$pageTitle = "Internal Portals";

// Define the unique administrator ID
$super_user_id = 1;
$current_user_id = (int)($_SESSION['user_id'] ?? 0);
$is_logged_in = isset($_SESSION['loggedin']) && $_SESSION['loggedin'] === true;

// 1. Check if the current user is the Super User (ID 1)
$is_super_user = ($is_logged_in && $current_user_id === $super_user_id); 

// 2. Normalize the user's department for department-based filtering
$user_dept = $is_logged_in ? trim(strtolower($_SESSION['department'] ?? '')) : '';

// 3. Check for general manage permission (used only for the "Manage Portals" link)
$can_manage_portals = $is_logged_in && function_exists('can') ? can('manage_portals') : false;

// --- PERMISSION CHECK ---
if ($is_logged_in && !$is_super_user) {
    checkPermission('view_portals_menu'); 
}
// ------------------------

// --- SEARCH LOGIC ---
$search_term = trim($_GET['search'] ?? '');
$search_sql_condition = '';
$search_param = '';

// Only apply search terms if logged in (Guests do not have a search bar anymore)
if ($is_logged_in && !empty($search_term)) {
    $search_sql_condition = " AND p.name LIKE ?";
    $search_param = '%' . $search_term . '%';
}
// --- END SEARCH LOGIC ---

// --- 1. Fetch Categories ---
$categories = [];
$cat_sql = "SELECT id, category_name FROM portal_categories ORDER BY sort_order ASC, category_name ASC";
$cat_result = $conn->query($cat_sql);
if ($cat_result) {
    while ($row = $cat_result->fetch_assoc()) {
        $categories[$row['id']] = $row;
    }
}

// --- 2. Fetch User Portals ---
$portals_data = [];

// Components for the SQL queries
$base_select_joins = "
    SELECT 
        p.id, 
        p.name, 
        p.url, 
        p.icon_path, 
        p.category_id, 
        pc.category_name 
    FROM 
        portals p 
    LEFT JOIN 
        portal_categories pc ON p.category_id = pc.id 
    LEFT JOIN 
        (SELECT portal_id, COUNT(*) as dept_count FROM portal_department_visibility GROUP BY portal_id) pdv_count ON p.id = pdv_count.portal_id
";
$group_by_order = " 
    GROUP BY 
        p.id, p.name, p.url, p.icon_path, p.category_id, pc.category_name 
    ORDER BY 
        p.sort_order ASC, p.name ASC
";


if ($is_super_user) {
    $sql_where = " WHERE 1=1"; 
    $sql = $base_select_joins . $sql_where . $search_sql_condition . $group_by_order;

    if (!empty($search_term)) {
        $stmt = $conn->prepare($sql);
        if ($stmt) {
            $stmt->bind_param("s", $search_param);
            $stmt->execute();
            $result = $stmt->get_result();
            while ($row = $result->fetch_assoc()) {
                $portals_data[] = $row;
            }
            $stmt->close();
        }
    } else {
        $result = $conn->query($sql);
        if ($result) {
            while ($row = $result->fetch_assoc()) {
                $portals_data[] = $row;
            }
        }
    }
    
} elseif ($is_logged_in) {
    $sql_where = "
        WHERE 
            NOT EXISTS (
                SELECT 1 
                FROM portal_department_visibility pdv_not_exist 
                WHERE pdv_not_exist.portal_id = p.id
            )
            OR
            EXISTS (
                SELECT 1 
                FROM portal_department_visibility pdv_exist 
                WHERE pdv_exist.portal_id = p.id 
                  AND LOWER(TRIM(pdv_exist.department_name)) = ? 
            )
    ";

    $sql = $base_select_joins . $sql_where . $search_sql_condition . $group_by_order; 

    $stmt = $conn->prepare($sql);
    if ($stmt) {
        $params = [$user_dept];
        $types = "s"; 

        if (!empty($search_term)) {
            $types .= "s";
            $params[] = $search_param;
        }

        $stmt->bind_param($types, ...$params); 
        $stmt->execute();
        $result = $stmt->get_result();
        
        while ($row = $result->fetch_assoc()) {
            $portals_data[] = $row;
        }
        $stmt->close();
    }
} else {
    $sql_where = "
        WHERE 
            NOT EXISTS (
                SELECT 1 
                FROM portal_department_visibility pdv_not_exist 
                WHERE pdv_not_exist.portal_id = p.id
            )
    ";
    
    $sql = $base_select_joins . $sql_where . $search_sql_condition . $group_by_order;

    if (!empty($search_term)) {
        $stmt = $conn->prepare($sql);
        if ($stmt) {
            $stmt->bind_param("s", $search_param);
            $stmt->execute();
            $result = $stmt->get_result();
            while ($row = $result->fetch_assoc()) { 
                $portals_data[] = $row; 
            }
            $stmt->close();
        }
    } else {
        $result = $conn->query($sql);
        if ($result) {
            while ($row = $result->fetch_assoc()) { 
                $portals_data[] = $row; 
            }
        }
    }
}

// Group portals by category for tab display
$portals_by_category = [];
foreach ($portals_data as $portal) {
    $categoryId = $portal['category_id'] ?? 0;
    if (!isset($portals_by_category[$categoryId])) {
        $portals_by_category[$categoryId] = [];
    }
    $portals_by_category[$categoryId][] = $portal;
}

// Fetch Dynamic Clock Configurations
$clock_settings_file = '../includes/clock_settings.json';
$clock_settings = [];
if (file_exists($clock_settings_file)) {
    $clock_settings = json_decode(file_get_contents($clock_settings_file), true);
}
// Fallback if empty
if (empty($clock_settings)) {
    $clock_settings = [
        ['label' => 'India (IST)', 'timezone' => 'Asia/Kolkata'],
        ['label' => 'New York (EST/EDT)', 'timezone' => 'America/New_York']
    ];
}

$json_clocks = json_encode($clock_settings);

// Determine active tab for page load
$active_category_id = $_GET['cat'] ?? 'all';
$active_category_id_int = $active_category_id === 'all' ? 'all' : (int)$active_category_id;

include_once '../includes/header.php';
?>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
