    }
    .form-control-search:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
    }

    /* Portal Grid & Cards */
    .portal-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 1.5rem;
        padding: 1.5rem;
    }
    
    .portal-btn {
        display: flex;
