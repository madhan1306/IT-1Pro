        .dropdown-item svg { width: 14px; height: 14px; }
        .dropdown-item:hover { background-color: #f1f5f9; color: var(--primary-color); }
        .dropdown-header { padding: 10px 12px; }

        /* User Profile Avatar */
        .user-avatar {
            width: 32px;
